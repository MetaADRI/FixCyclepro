APP_NAME=Fixcycle
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.onrender.com

LOG_CHANNEL=daily
LOG_SLACK_WEBHOOK_URL=

BCRYPT_ROUNDS=12

# NOTE: config/queue.php reads QUEUE_DRIVER (legacy key), not QUEUE_CONNECTION
QUEUE_DRIVER=database
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
CACHE_DRIVER=file

# CORS — comma-separated allowed browser origins. Empty/* preserves legacy
# wildcard behaviour; set explicit origins in production, e.g.
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Native Android clients ignore CORS entirely; this only affects browsers.
CORS_ALLOWED_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=false

# Trusted reverse-proxy IPs/CIDRs. Default '*' trusts the platform load
# balancer so X-Forwarded-Proto is honoured (prevents https->http redirect
# loops on Render). Set to '' only when running without a proxy.
TRUSTED_PROXIES=*

# Rate limit for the `limit_api` middleware (OTP endpoints), per IP.
LIMIT_API_MAX=2
LIMIT_API_DECAY=60
BROADCAST_DRIVER=log
FILESYSTEM_DRIVER=local
FILESYSTEM_CLOUD=local

# PostgreSQL (Neon.tech) — Neon requires sslmode=require
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=
DB_SSLMODE=require

# Ride-tracking socket microservice (separate Node service; PWA uses polling instead)
MICRO_SERVICE_APP_URL=/
MICRO_SERVICE_APP_FULL_URL=https://your-socket-host

# Push / realtime
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
WEBHOOK_VERIFY_TOKEN=

# Mail
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAILGUN_DOMAIN=
MAILGUN_SECRET=
SPARKPOST_SECRET=
SES_KEY=
SES_SECRET=
SES_REGION=

# SMS
TWILIO_AUTH_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Payment gateways
STRIPE_KEY=
STRIPE_SECRET=
PAYGATE_ID=
PAYGATE_PASSWORD=
IUGU_API_KEY=
PAYMENT_PATH=
CERTIFICATE_FILE_PATH=

# Maps / misc
WKHTML_PDF_BINARY=
WKHTML_IMG_BINARY=
DRIVER_CHOICE_MIN_DISTANCE=
JWT_SECRET=
MASTER_PASS=

# AWS (S3 etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_BUCKET_URL=
AWS_URL=
AWS_SDK_LOAD_NONDEFAULT_CONFIG=false

# Redis (only if REDIS_FOR_CONFIG=true)
REDIS_FOR_CONFIG=false
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Memcached / SQS (unused on Render hobby — left for completeness)
MEMCACHED_HOST=
MEMCACHED_PORT=
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_PERSISTENT_ID=
SQS_KEY=
SQS_SECRET=
SQS_PREFIX=
SQS_QUEUE=
SQS_REGION=

# Proxy (leave empty unless behind a corporate proxy)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Telescope / Debugbar — must stay disabled in production
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
# Other Telescope keys read by config/telescope.php (only matter if TELESCOPE_ENABLED=true):
#   TELESCOPE_DOMAIN, TELESCOPE_DRIVER, TELESCOPE_PATH, TELESCOPE_BATCH_WATCHER,
#   TELESCOPE_CACHE_WATCHER, TELESCOPE_CLIENT_REQUEST_WATCHER, TELESCOPE_COMMAND_WATCHER,
#   TELESCOPE_DUMP_WATCHER, TELESCOPE_DUMP_WATCHER_ALWAYS, TELESCOPE_EVENT_WATCHER,
#   TELESCOPE_EXCEPTION_WATCHER, TELESCOPE_GATE_WATCHER, TELESCOPE_JOB_WATCHER,
#   TELESCOPE_LOG_WATCHER, TELESCOPE_MAIL_WATCHER, TELESCOPE_MODEL_WATCHER,
#   TELESCOPE_NOTIFICATION_WATCHER, TELESCOPE_QUERY_WATCHER, TELESCOPE_REDIS_WATCHER,
#   TELESCOPE_REQUEST_WATCHER, TELESCOPE_RESPONSE_SIZE_LIMIT, TELESCOPE_SCHEDULE_WATCHER,
#   TELESCOPE_VIEW_WATCHER
# Other Debugbar keys read by config/debugbar.php (only matter if DEBUGBAR_ENABLED=true):
#   DEBUGBAR_EDITOR, DEBUGBAR_THEME, DEBUGBAR_LOCAL_SITES_PATH,
#   DEBUGBAR_REMOTE_SITES_PATH, DEBUGBAR_OPEN_STORAGE
# Guzzle tuning (read by the vendored Guzzle under app/Http/Controllers/SmsGateways):
GUZZLE_CURL_SELECT_TIMEOUT=
# HOME / HOMEDRIVE / HOMEPATH are read by vendored AWS SDK code — OS-level, never set them here.

# Web PWA merchant credentials (read by config/web.php, exposed to resources/js/app.js).
# The browser cannot hold a secret key, so the public API is authenticated with a
# server-injected `access_pin`. When unset the API returns "unauthorised request".
WEB_MERCHANT_ID=
WEB_MERCHANT_ACCESS_PIN=

# Web display currency (UI only — payment gateways keep their own configuration).
WEB_CURRENCY=ZMW
WEB_CURRENCY_SYMBOL=K

# Legacy payment-gateway / integration credentials.
# These were previously hard-coded in app/Http/Controllers/** and are now read
# from the environment. Leave blank to disable the corresponding legacy gateway.
MPESA_PASSKEY=
TWOCTWOP_SECRET_KEY=
BEYONIC_API_SECRET_KEY=
ONEVISION_SECRET_KEY=
PAYGO_API_SECRET_KEY_UAT=
PAYPHONE_ARRAFFINITY_COOKIE=
KORBA_HMAC_SECRET=
IQ_USER_PASSWORD=
WASL_CLIENT_ID=
WASL_APP_ID=
WASL_APP_KEY=
WASL_COOKIE=
BREVO_API_KEY=
MPESA_LIB_PASSKEY=
TOUCHPAY_USER_NAME=
TOUCHPAY_PASSWORD=
TOLL_API_TOKEN=
AAMARPAY_SANDBOX_SECRET_KEY=
CLOVER_ACCESS_TOKEN=
CLOVER_PUBLIC_TOKEN=
MERCADO_CLIENT_SECRET=
MPES_MIGS_SECURE_SECRET=
PAYGATEGLOBAL_AUTH_TOKEN=
SQUARE_AUTH_TOKEN=
PAYOUTS_SERVICE_SECRET=
MPESA_LIB_CONSUMER_KEY=
MPESA_LIB_CONSUMER_SECRET=
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
MAILGUN_SECRET=
MAILGUN_DOMAIN=
LEGACY_DB_HOST=
LEGACY_DB_PORT=
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
